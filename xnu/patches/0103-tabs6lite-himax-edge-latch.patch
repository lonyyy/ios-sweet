 static const struct himax_io hx_io = { NULL, hx_xfer };
 
+/*
+ * L'IRQ du Himax est une impulsion (journal Android : HX_INT_IS_EDGE = 1) : lue au niveau toutes
+ * les 10 ms, elle restait à 1 (relevé sur la tablette). Le TLMM mémorise les fronts dans le statut
+ * d'interruption de la broche si « raw status » est mis, même sans livrer l'interruption au GIC
+ * (enable = 0) : registres de broche +0x8 (cfg) et +0xC (statut), disposition sc7180 de Linux.
+ */
+#define TLMM_INTR_CFG(n)        (TOUCH_GPIO_CFG(n) + 0x8u)
+#define TLMM_INTR_STATUS(n)     (TOUCH_GPIO_CFG(n) + 0xcu)
+#define TLMM_INTR_RAW_STATUS    (1u << 4)
+#define TLMM_INTR_FALLING       (2u << 2 | 1u << 1)     /* détection front descendant, polarité 1 */
+
 static void
+hx_irq_latch_init(void)
+{
+	touch_wr(touch_tile(HX_IRQ), TLMM_INTR_CFG(HX_IRQ), TLMM_INTR_RAW_STATUS | TLMM_INTR_FALLING);
+	touch_wr(touch_tile(HX_IRQ), TLMM_INTR_STATUS(HX_IRQ), 0);
+}
+
+/* Un front descendant depuis le dernier appel (statut remis à zéro), ou la ligne basse. */
+static bool
+hx_irq_seen(void)
+{
+	bool edge = touch_rd(touch_tile(HX_IRQ), TLMM_INTR_STATUS(HX_IRQ)) & 1u;
+	if (edge) {
+		touch_wr(touch_tile(HX_IRQ), TLMM_INTR_STATUS(HX_IRQ), 0);
+	}
+	return edge || !touch_gpio_level(HX_IRQ);
+}
+
+static void
 hx_pins(void)
 {
 	touch_gpio(HX_CS, 0, 0, 2, true, true);
@@ -103,24 +132,32 @@
 	touch_wait(20);

+/*
+ * Tab S6 Lite (atoll) : the TLMM has three register tiles (WEST, NORTH, SOUTH at +0x100000,
+ * +0x500000, +0x900000) and a pin exists in one of them only. The tile of a pin is found by
+ * flipping its pull-down bit in each and reading it back (restored at once) ; NORTH when none answers.
+ */
+#define TOUCH_TILES     3u
+#define TOUCH_PINS      128u
+static const uint32_t touch_tile_pa[TOUCH_TILES] = { 0x03500000u, TOUCH_NORTH_PA, 0x03d00000u };
+static vm_offset_t touch_tiles[TOUCH_TILES], touch_pin_tile[TOUCH_PINS];
+
+static vm_offset_t
+touch_tile(unsigned pin)
+{
+	if (touch_pin_tile[pin] == 0) {
+		touch_pin_tile[pin] = st.gpio;
+		for (unsigned t = 0; t < TOUCH_TILES; t++) {
+			vm_offset_t base = touch_tiles[t];
+			if (base == 0) {
+				continue;
+			}
+			uint32_t old = touch_rd(base, TOUCH_GPIO_CFG(pin));
+			touch_wr(base, TOUCH_GPIO_CFG(pin), old ^ 1u);
+			bool answers = touch_rd(base, TOUCH_GPIO_CFG(pin)) == (old ^ 1u);
+			touch_wr(base, TOUCH_GPIO_CFG(pin), old);
+			if (answers) {
+				touch_pin_tile[pin] = base;
+				printf("SWEET TOUCH: gpio%u is in TLMM tile %u (cfg %#x)\n", pin, t, old);
+				break;
+			}
+		}
+	}
+	return touch_pin_tile[pin];
+}
+
 static void
 touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
 {
+	vm_offset_t tile = touch_tile(pin);
 	uint32_t off = TOUCH_GPIO_CFG(pin);
-	uint32_t cfg = touch_rd(st.gpio, off);
+	uint32_t cfg = touch_rd(tile, off);
 	if (out) {
 		/* Set the desired latch before enabling output (reset is active low). */
-		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
-		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+		touch_wr(tile, TOUCH_GPIO_IO(pin),
+		    (touch_rd(tile, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
 	}
 	cfg &= ~0x3ffu;
 	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
-	touch_wr(st.gpio, off, cfg);
+	touch_wr(tile, off, cfg);
 }
 
 static bool
+touch_gpio_level(unsigned pin)
+{
+	return touch_rd(touch_tile(pin), TOUCH_GPIO_IO(pin)) & 1u;
+}

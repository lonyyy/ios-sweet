@@ -80,9 +80,72 @@
 
 OSDefineMetaClassAndStructors(SweetSurface, OSObject);
 
+/*
+ * Tab S6 Lite : pool of screen-size buffers, physically contiguous below 4 GiB, allocated once
+ * when AppleCLCD starts (memory is still unfragmented). Measured on the tablet : flipping worked
+ * on the first boot, then every frame was copied (flip=0) : later 12 MiB contiguous allocations
+ * failed. Screen-size surfaces take a free pool buffer first.
+ */
+#define SWEET_FLIP_POOL 4
+static IOBufferMemoryDescriptor *sweet_flip_pool[SWEET_FLIP_POOL];
+static uint64_t sweet_flip_pool_phys[SWEET_FLIP_POOL];
+static bool sweet_flip_pool_used[SWEET_FLIP_POOL];
+static uint32_t sweet_flip_pool_size;
+
+extern "C" void
+sweet_flip_pool_init(uint32_t size)
+{
+	unsigned got = 0;
+	sweet_flip_pool_size = size;
+	for (unsigned i = 0; i < SWEET_FLIP_POOL; i++) {
+		IOBufferMemoryDescriptor *m = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, size, 0x00000000fffff000ULL);
+		uint64_t phys = m != NULL ? sweet_surface_contiguous(m, size) : 0;
+		if (phys == 0) {
+			OSSafeReleaseNULL(m);
+			continue;
+		}
+		sweet_flip_pool[i] = m;
+		sweet_flip_pool_phys[i] = phys;
+		got++;
+	}
+	printf("SWEET SURF: flip pool %u x %u KiB reserved\n", got, size >> 10);
+}
+
+/* A free pool buffer of at least size bytes (retained, marked used), or NULL. */
+static IOBufferMemoryDescriptor *
+sweet_flip_pool_take(uint32_t size, uint64_t *phys)
+{
+	IOBufferMemoryDescriptor *m = NULL;
+	IOLockLock(sweet_surface_lock);
+	for (unsigned i = 0; i < SWEET_FLIP_POOL && m == NULL; i++) {
+		if (sweet_flip_pool[i] != NULL && !sweet_flip_pool_used[i] && size <= sweet_flip_pool_size) {
+			sweet_flip_pool_used[i] = true;
+			m = sweet_flip_pool[i];
+			m->retain();
+			*phys = sweet_flip_pool_phys[i];
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return m;
+}
+
+static void
+sweet_flip_pool_give(IOMemoryDescriptor *m)
+{
+	IOLockLock(sweet_surface_lock);
+	for (unsigned i = 0; i < SWEET_FLIP_POOL; i++) {
+		if (m != NULL && m == sweet_flip_pool[i]) {
+			sweet_flip_pool_used[i] = false;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+}
+
 void
 SweetSurface::free()
 {
+	sweet_flip_pool_give(memory);
 	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
 		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
 	}

 	    fLogicalW <= fWidth && fLogicalH <= fHeight) {
-		for (unsigned i = 0; i < 6; i++) {
-			sweet_splash[i] = mdp_rd(SSPP0 + sweet_sspp_regs[i]);
+		int scale = 1;
+		PE_parse_boot_argn("sweetfb_scale", &scale, sizeof(scale));
+		if (scale) {
+			/* the largest size of the same shape that fits the panel, even, centered */
+			uint32_t vw = fWidth, vh = fHeight;
+			if ((uint64_t)fLogicalW * fHeight <= (uint64_t)fLogicalH * fWidth) {
+				vw = (uint32_t)((uint64_t)fLogicalW * fHeight / fLogicalH) & ~1u;
+			} else {
+				vh = (uint32_t)((uint64_t)fLogicalH * fWidth / fLogicalW) & ~1u;
+			}
+			sweet_fb_view[0] = (int32_t)(fWidth - vw) / 2;
+			sweet_fb_view[1] = (int32_t)(fHeight - vh) / 2;
+			sweet_fb_view[2] = (int32_t)vw;
+			sweet_fb_view[3] = (int32_t)vh;
 		}
+		/* the pipe reads the image from the top left of whatever buffer it scans : the copy path too */
+		fOffX = fOffY = 0;
+		sweet_panel_phys = (uint32_t)fPhys;
+		sweet_panel_bpr = fRowBytes;
+		mdp_set_view(fLogicalW, fLogicalH);
+		mdp_show(sweet_panel_phys, sweet_panel_bpr);
 		sweet_fb_flip_w = fLogicalW;
 		sweet_fb_flip_h = fLogicalH;
 	}
-	IOLog("SWEET FB: flip %s (SSPP0 addr 0x%x, presented %ux%u)\n", sweet_fb_flip_w ? "on" : "off",
-	    sweet_mdp ? mdp_rd(SSPP0 + SSPP_SRC0_ADDR) : 0, fLogicalW, fLogicalH);
+	IOLog("SWEET FB: flip %s, %ux%u shown at %d,%d %dx%d (qseed op 0x%x)\n", sweet_fb_flip_w ? "on" : "off",
+	    fLogicalW, fLogicalH, sweet_fb_view[0], sweet_fb_view[1], sweet_fb_view[2], sweet_fb_view[3],
+	    sweet_fb_flip_w ? mdp_rd(QS + QS_OP_MODE) : 0);
 	registerService();
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
@@ -304,12 +351,12 @@
 			/* the panel was showing an iOS surface : copy it once into the panel buffer, go back to it */
 			SweetSurface *s = sweet_shown;
 			uintptr_t src = s->kernelAddress();
-			uint32_t ox = (fb->fWidth - s->width) / 2, oy = (fb->fHeight - s->height) / 2;
+			uint32_t ox = (uint32_t)-fb->fOffX, oy = (uint32_t)-fb->fOffY;
 			for (uint32_t y = 0; src != 0 && y < s->height; y++) {
 				memcpy((void *)(fb->fPixels + (uint64_t)(oy + y) * fb->fRowBytes + (uint64_t)ox * 4),
 				    (const void *)(src + s->offset + (uint64_t)y * s->bytesPerRow), (size_t)s->width * 4);
 			}
-			mdp_restore_splash();
+			mdp_show(sweet_panel_phys, sweet_panel_bpr);
 			sweet_shown = NULL;
 			s->release();
 		}
@@ -428,7 +475,7 @@
 		}
 		if (phys != 0 && phys + (uint64_t)s->bytesPerRow * s->height <= 0x100000000ULL &&
 		    seg >= (IOByteCount)s->bytesPerRow * s->height) {
-			mdp_show(phys, s->width, s->height, s->bytesPerRow, fWidth, fHeight);
+			mdp_show(phys, s->bytesPerRow);
 			SweetSurface *old = sweet_shown;
 			sweet_shown = s;                /* keep it while it is scanned out */
 			if (old != NULL) {
@@ -443,7 +490,7 @@
 		OSSafeReleaseNULL(s);
 		if (sweet_shown != NULL) {
 			/* back to copying : the panel buffer again */
-			mdp_restore_splash();
+			mdp_show(sweet_panel_phys, sweet_panel_bpr);
 			sweet_shown->release();

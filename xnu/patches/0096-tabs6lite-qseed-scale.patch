 #define FLUSH_SSPP0_LM0_CTL ((1u << 0) | (1u << 6) | (1u << 17))
+/* QSEED3 scaler of the VIG pipe (SSPP0 + 0xa00), as validated by shim test 2e on the tablet */
+#define QS              (SSPP0 + 0xa00u)
+#define QS_OP_MODE      0x04
+#define QS_STEP_Y_H     0x10
+#define QS_PRELOAD      0x20
+#define QS_SRC_Y        0x40
+#define QS_SRC_UV       0x44
+#define QS_DST          0x48
+#define QS_INIT_Y_H     0x90
 static vm_offset_t sweet_mdp;
-static uint32_t sweet_splash[6];        /* SSPP0 as the boot loader left it */
 static SweetSurface *sweet_shown;       /* the surface the panel scans now, retained */
-static const uint32_t sweet_sspp_regs[6] = { SSPP_SRC0_ADDR, SSPP_YSTRIDE0, SSPP_SRC_SIZE, SSPP_SRC_XY, SSPP_OUT_SIZE, SSPP_OUT_XY };
+static uint32_t sweet_panel_phys, sweet_panel_bpr;      /* the boot loader's buffer : the copy path draws there */
+/* Where the presented image is on the panel : x, y, width, height (the touch driver maps with it). */
+extern "C" int32_t sweet_fb_view[4];
+int32_t sweet_fb_view[4];
 
 static inline uint32_t mdp_rd(uint32_t off) { return *(volatile uint32_t *)(sweet_mdp + off); }
 static inline void mdp_wr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(sweet_mdp + off) = v; }
@@ -74,26 +85,39 @@
 	}
 }
 
-/* Point SSPP0 at `phys` (w x h, stride bpr), centered on the panel. */
+/* Scan the presented image from `phys` (stride bpr) : a flip. */
 static void
-mdp_show(uint64_t phys, uint32_t w, uint32_t h, uint32_t bpr, uint32_t pw, uint32_t ph)
+mdp_show(uint64_t phys, uint32_t bpr)
 {
 	mdp_wr(SSPP0 + SSPP_SRC0_ADDR, (uint32_t)phys);
 	mdp_wr(SSPP0 + SSPP_YSTRIDE0, bpr);
-	mdp_wr(SSPP0 + SSPP_SRC_SIZE, w | h << 16);
-	mdp_wr(SSPP0 + SSPP_SRC_XY, 0);
-	mdp_wr(SSPP0 + SSPP_OUT_SIZE, w | h << 16);
-	mdp_wr(SSPP0 + SSPP_OUT_XY, ((pw - w) / 2) | ((ph - h) / 2) << 16);
 	mdp_flush();
 }
 
+/*
+ * Once : SSPP0 reads a w x h image and shows it in sweet_fb_view, scaled by QSEED3 when the sizes
+ * differ (steps are source/destination in 21-bit fixed point, bilinear filter).
+ */
 static void
-mdp_restore_splash(void)
+mdp_set_view(uint32_t w, uint32_t h)
 {
-	for (unsigned i = 0; i < 6; i++) {
-		mdp_wr(SSPP0 + sweet_sspp_regs[i], sweet_splash[i]);
+	uint32_t vw = (uint32_t)sweet_fb_view[2], vh = (uint32_t)sweet_fb_view[3];
+	if (vw != w || vh != h) {
+		uint32_t step_x = (uint32_t)(((uint64_t)w << 21) / vw), step_y = (uint32_t)(((uint64_t)h << 21) / vh);
+		for (unsigned i = 0; i < 4; i++) {
+			mdp_wr(QS + QS_STEP_Y_H + 4 * i, (i & 1) ? step_y : step_x);   /* Y_H, Y_V, UV_H, UV_V */
+			mdp_wr(QS + QS_INIT_Y_H + 4 * i, 0);
+		}
+		mdp_wr(QS + QS_PRELOAD, 4u | 3u << 8 | 4u << 16 | 3u << 24);
+		mdp_wr(QS + QS_SRC_Y, w | h << 16);
+		mdp_wr(QS + QS_SRC_UV, w | h << 16);
+		mdp_wr(QS + QS_DST, vw | vh << 16);
+		mdp_wr(QS + QS_OP_MODE, 1u | 3u << 16 | 1u << 14);
 	}
-	mdp_flush();
+	mdp_wr(SSPP0 + SSPP_SRC_SIZE, w | h << 16);
+	mdp_wr(SSPP0 + SSPP_SRC_XY, 0);
+	mdp_wr(SSPP0 + SSPP_OUT_SIZE, vw | vh << 16);
+	mdp_wr(SSPP0 + SSPP_OUT_XY, (uint32_t)sweet_fb_view[0] | (uint32_t)sweet_fb_view[1] << 16);
 }
 

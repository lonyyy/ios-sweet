+/*
+ * Tab S6 Lite (SM7125 MDP) : zero-copy presentation. Measured on the tablet (shim test 2d) :
+ * rewriting SSPP0's SRC0_ADDR and flushing CTL0 shows another buffer at the next vsync,
+ * 60 times a second. Register offsets from the tablet's DT (mdp_phys 0xae00000, sspp-off
+ * 0x5000, ctl-off 0x2000) and Linux's DPU driver.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" uint32_t sweet_fb_flip_w, sweet_fb_flip_h;
+uint32_t sweet_fb_flip_w, sweet_fb_flip_h;
+#define MDP_PA          0x0ae00000ULL
+#define MDP_SIZE        0x30000
+#define SSPP0           0x5000u
+#define SSPP_SRC_SIZE   0x00
+#define SSPP_SRC_XY     0x08
+#define SSPP_OUT_SIZE   0x0c
+#define SSPP_OUT_XY     0x10
+#define SSPP_SRC0_ADDR  0x14
+#define SSPP_YSTRIDE0   0x24
+#define CTL0_FLUSH      (0x2000u + 0x18u)
+#define FLUSH_SSPP0_LM0_CTL ((1u << 0) | (1u << 6) | (1u << 17))
+static vm_offset_t sweet_mdp;
+static uint32_t sweet_splash[6];        /* SSPP0 as the boot loader left it */
+static SweetSurface *sweet_shown;       /* the surface the panel scans now, retained */
+static const uint32_t sweet_sspp_regs[6] = { SSPP_SRC0_ADDR, SSPP_YSTRIDE0, SSPP_SRC_SIZE, SSPP_SRC_XY, SSPP_OUT_SIZE, SSPP_OUT_XY };
+
+static inline uint32_t mdp_rd(uint32_t off) { return *(volatile uint32_t *)(sweet_mdp + off); }
+static inline void mdp_wr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(sweet_mdp + off) = v; }
+
+static void
+mdp_flush(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	mdp_wr(CTL0_FLUSH, FLUSH_SSPP0_LM0_CTL);
+	for (unsigned i = 0; i < 2000 && (mdp_rd(CTL0_FLUSH) & FLUSH_SSPP0_LM0_CTL); i++) {
+		IODelay(10);                    /* latches at the next vsync : at most ~17 ms */
+	}
+}
+
+/* Point SSPP0 at `phys` (w x h, stride bpr), centered on the panel. */
+static void
+mdp_show(uint64_t phys, uint32_t w, uint32_t h, uint32_t bpr, uint32_t pw, uint32_t ph)
+{
+	mdp_wr(SSPP0 + SSPP_SRC0_ADDR, (uint32_t)phys);
+	mdp_wr(SSPP0 + SSPP_YSTRIDE0, bpr);
+	mdp_wr(SSPP0 + SSPP_SRC_SIZE, w | h << 16);
+	mdp_wr(SSPP0 + SSPP_SRC_XY, 0);
+	mdp_wr(SSPP0 + SSPP_OUT_SIZE, w | h << 16);
+	mdp_wr(SSPP0 + SSPP_OUT_XY, ((pw - w) / 2) | ((ph - h) / 2) << 16);
+	mdp_flush();
+}
+
+static void
+mdp_restore_splash(void)
+{
+	for (unsigned i = 0; i < 6; i++) {
+		mdp_wr(SSPP0 + sweet_sspp_regs[i], sweet_splash[i]);
+	}
+	mdp_flush();
+}

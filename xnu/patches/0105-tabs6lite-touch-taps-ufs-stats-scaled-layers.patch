+extern uint64_t sweet_ufs_stat[3];
+
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	uint64_t t0 = mach_absolute_time();
+	int error = ufs_scsi_run(cdb, cdb_len, len, write);
+	sweet_ufs_stat[0]++;
+	sweet_ufs_stat[1] += len;
+	sweet_ufs_stat[2] += mach_absolute_time() - t0;
+	return error;
+}

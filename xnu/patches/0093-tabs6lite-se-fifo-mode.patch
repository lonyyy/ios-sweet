+/*
+ * Tab S6 Lite (atoll) : a serial engine whose FIFO interface the boot chain left disabled
+ * (GENI_IF_DISABLE_RO 0x64 bit 0, GSI-only) is put back in FIFO mode the way Linux's
+ * geni_se_select_mode does : DMA_IF_EN in 0x2004, then FIFO_IF_DISABLE cleared in 0x2008.
+ * Returns true when the FIFO interface is usable.
+ */
 static bool
+tabs6lite_se_fifo(vm_offset_t se, const char *who)
+{
+	uint32_t before = touch_rd(se, 0x64);
+	if (before & 1u) {
+		touch_wr(se, 0x2004, touch_rd(se, 0x2004) | 1u);
+		touch_wr(se, 0x2008, touch_rd(se, 0x2008) & ~1u);
+	}
+	uint32_t after = touch_rd(se, 0x64);
+	printf("SWEET TOUCH: %s fifo-if before=%#x after=%#x dma-if=%#x fifo-dis=%#x\n", who, before, after,
+	    touch_rd(se, 0x2004), touch_rd(se, 0x2008));
+	return !(after & 1u);
+}
+
+static bool
 touch_se_init(void)
 {
 	uint32_t fw = touch_rd(st.se, SE_FW);
@@ -861,6 +881,7 @@
 	printf("SWEET TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
 	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
 	    touch_rd(st.se, 0x908));
+	(void)tabs6lite_se_fifo(st.se, "se7");
 	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
 	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
 	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {

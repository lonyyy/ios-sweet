@@ -141,18 +139,39 @@
 	return ok;
 }
 
-/* Une trame si l'IRQ est basse ; remonte les doigts 0 à 8 (le 9e emplacement est celui du S Pen). */
+/*
+ * Une trame à chaque impulsion d'IRQ ; remonte les doigts 0 à 8 (le 9e emplacement est au S Pen).
+ * Relevé sur la tablette (0105) : relue sans impulsion, la pile rend la DERNIÈRE trame, doigt
+ * compris : la lecture de secours toutes les 250 ms tenait un doigt fantôme appuyé (appui long
+ * sur l'écran verrouillé = éditeur de fond d'écran, tactile « mort »). Plus de lecture sans
+ * impulsion ; tant qu'un doigt est posé la puce en envoie une à chaque balayage (~60-120 Hz),
+ * donc 80 ms sans impulsion = doigts levés.
+ */
+#define HX_LIFT_POLLS 8u
+
 static void
 hx_poll(void)
 {
-	static unsigned logged, ticks, edges;
+	static unsigned logged, quiet, edges;
 	uint8_t ev[HIMAX_EVENT_LEN];
 	bool irq = hx_irq_seen();
 	edges += irq;
 	hx_stat[0] += irq;
-	/* sans front, une lecture toutes les 250 ms quand même : la pile dit si la puce balaie */
+	uint32_t fingers = st.active & ((1u << SPEN_SLOT) - 1u);
+	if (!irq) {
+		if (fingers && ++quiet >= HX_LIFT_POLLS) {
+			int x[TOUCH_MAX], y[TOUCH_MAX];
+			for (unsigned i = 0; i < TOUCH_MAX; i++) {
+				x[i] = st.x[i];
+				y[i] = st.y[i];
+			}
+			touch_report(st.active & (1u << SPEN_SLOT), x, y);   /* lève les doigts, garde le stylet */
+		}
+		return;
+	}
+	quiet = 0;
 	uint64_t t0 = mach_absolute_time();
-	if ((!irq && (++ticks % 25u) != 0) || himax_read_event(&hx_io, ev)) {
+	if (himax_read_event(&hx_io, ev)) {
 		return;
 	}
 	hx_stat[1]++;

diff --color -ruN a/bsd/dev/tabs6lite_i2c_gpio.c b/bsd/dev/tabs6lite_i2c_gpio.c
--- a/bsd/dev/tabs6lite_i2c_gpio.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_i2c_gpio.c	2026-11-13 15:48:07
@@ -0,0 +1,154 @@
+/* I2C maître logiciel : voir i2c_gpio.h. Écrit pour ce portage. */
+#include "i2c_gpio.h"
+#ifdef KERNEL
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+
+#define I2C_SDA 0u
+#define I2C_SCL 1u
+
+static void i2c_half(const struct i2c_gpio_ops *o) { o->udelay(o->ctx, o->half_us); }
+
+/* Relâche I2C_SCL et attend qu'il monte (l'esclave peut l'étirer) : au plus ~25 ms. */
+static int
+i2c_scl_high(const struct i2c_gpio_ops *o)
+{
+	o->drive(o->ctx, I2C_SCL, false);
+	for (unsigned i = 0; i < 5000; i++) {
+		if (o->sense(o->ctx, I2C_SCL)) {
+			return 0;
+		}
+		o->udelay(o->ctx, 5);
+	}
+	return -ETIMEDOUT;
+}
+
+static int
+i2c_start(const struct i2c_gpio_ops *o)
+{
+	o->drive(o->ctx, I2C_SDA, false);                 /* I2C_SDA haut (START répété : depuis I2C_SCL bas) */
+	i2c_half(o);
+	int e = i2c_scl_high(o);
+	if (e) {
+		return e;
+	}
+	if (!o->sense(o->ctx, I2C_SDA)) {
+		return -EBUSY;
+	}
+	i2c_half(o);
+	o->drive(o->ctx, I2C_SDA, true);                  /* I2C_SDA descend, I2C_SCL haut : START */
+	i2c_half(o);
+	o->drive(o->ctx, I2C_SCL, true);
+	return 0;
+}
+
+static void
+i2c_stop(const struct i2c_gpio_ops *o)
+{
+	o->drive(o->ctx, I2C_SDA, true);
+	i2c_half(o);
+	(void)i2c_scl_high(o);
+	i2c_half(o);
+	o->drive(o->ctx, I2C_SDA, false);                 /* I2C_SDA monte, I2C_SCL haut : STOP */
+	i2c_half(o);
+}
+
+/* Un bit, MSB d'abord ; renvoie le niveau lu sur I2C_SDA pendant que I2C_SCL est haut. */
+static int
+i2c_bit(const struct i2c_gpio_ops *o, bool one)
+{
+	o->drive(o->ctx, I2C_SDA, !one);
+	i2c_half(o);
+	int e = i2c_scl_high(o);
+	if (e) {
+		return e;
+	}
+	int v = o->sense(o->ctx, I2C_SDA) ? 1 : 0;
+	i2c_half(o);
+	o->drive(o->ctx, I2C_SCL, true);
+	return v;
+}
+
+/* Écrit un octet ; renvoie 0 si l'esclave l'acquitte (I2C_SDA bas au 9e coup), 1 sinon. */
+static int
+i2c_put(const struct i2c_gpio_ops *o, uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		int e = i2c_bit(o, (b >> i) & 1u);
+		if (e < 0) {
+			return e;
+		}
+	}
+	return i2c_bit(o, true);                          /* 0 = ACK, 1 = NACK, < 0 erreur */
+}
+
+static int
+i2c_get(const struct i2c_gpio_ops *o, uint8_t *b, bool ack)
+{
+	unsigned v = 0;
+	for (int i = 0; i < 8; i++) {
+		int e = i2c_bit(o, true);
+		if (e < 0) {
+			return e;
+		}
+		v = v << 1 | (unsigned)e;
+	}
+	*b = (uint8_t)v;
+	int e = i2c_bit(o, !ack);
+	return e < 0 ? e : 0;
+}
+
+int
+i2c_gpio_recover(const struct i2c_gpio_ops *o)
+{
+	o->drive(o->ctx, I2C_SDA, false);
+	for (unsigned i = 0; i < 9 && !o->sense(o->ctx, I2C_SDA); i++) {
+		o->drive(o->ctx, I2C_SCL, true);
+		i2c_half(o);
+		(void)i2c_scl_high(o);
+		i2c_half(o);
+	}
+	o->drive(o->ctx, I2C_SCL, true);
+	i2c_half(o);
+	i2c_stop(o);
+	return o->sense(o->ctx, I2C_SDA) && o->sense(o->ctx, I2C_SCL) ? 0 : -EBUSY;
+}
+
+static int
+i2c_phase(const struct i2c_gpio_ops *o, uint8_t addr, bool rd, const uint8_t *tx, uint8_t *rx, size_t n)
+{
+	int e = i2c_start(o);
+	if (e) {
+		return e;
+	}
+	e = i2c_put(o, (uint8_t)(addr << 1 | (rd ? 1u : 0u)));
+	if (e) {
+		return e < 0 ? e : -ENXIO;
+	}
+	for (size_t i = 0; i < n; i++) {
+		e = rd ? i2c_get(o, &rx[i], i + 1 < n) : i2c_put(o, tx[i]);
+		if (e) {
+			return e < 0 ? e : -EIO;
+		}
+	}
+	return 0;
+}
+
+int
+i2c_gpio_xfer(const struct i2c_gpio_ops *o, uint8_t addr, const uint8_t *tx, size_t nt, uint8_t *rx,
+    size_t nr, bool hold)
+{
+	int e = 0;
+	if (nt || !nr) {
+		e = i2c_phase(o, addr, false, tx, NULL, nt);
+	}
+	if (!e && nr) {
+		e = i2c_phase(o, addr, true, NULL, rx, nr);
+	}
+	if (e || !hold) {
+		i2c_stop(o);
+	}
+	return e;
+}

diff --color -ruN a/bsd/dev/tabs6lite_bt.c b/bsd/dev/tabs6lite_bt.c
--- a/bsd/dev/tabs6lite_bt.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_bt.c	2026-11-13 14:17:11
@@ -0,0 +1,126 @@
+/*
+ * Bluetooth de la Galaxy Tab S6 Lite 2022 sous XNU, côté noyau : démarrer la radio WCN3990 et
+ * scanner en BLE, sans la pile Bluetooth d'iOS (qui n'accepte que des puces Apple). Activé par le
+ * boot-arg tabs6lite_bt=1 ; résultat sur la console de l'écran (« SWEET BT: ... »).
+ *
+ * Inclus depuis bsd/dev/sweet_touch.c (patch 0091) : il en réutilise touch_wait(), ml_io_map() et
+ * sweet_rpmh_vreg_enable(), et partage le moteur série GENI et le vote RPMh du tactile.
+ * Matériel (DT et pilotes Samsung SM7125, relevés) :
+ *   UART      qupv3_se3_4uart 0x88c000 ; GPIO 25 (qup05 = fonction 3), 26-28 (fonction 2), zone SOUTH
+ *   horloges  GCC vote 0x52008 bits 6/7 (AHB wrap0), 8/9 (cœur wrap0), 13 (S3) ; RCG 0x173c4 en DFS
+ *   rails     L1C 1,8 V (xtal), L2C 1,3 V (cœur), L10C 3,3 V (PA) ; vdd-io L10A déjà allumé
+ */
+#include "tabs6lite_geni_uart.c"
+#include "tabs6lite_qca_bt.c"
+
+#define BT_SE_PA        GENI_UART_BT_PA
+#define BT_SOUTH_PA     0x03d00000u     /* TLMM 0x3400000 + SOUTH 0x900000 */
+#define BT_GCC_VOTE     0x52008u
+#define BT_GCC_BITS     ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 13))
+#define BT_RCG          0x173c4u
+
+static vm_offset_t bt_gcc, bt_se, bt_tlmm;
+static uint32_t bt_rd(uintptr_t a) { return *(volatile uint32_t *)a; }
+static void bt_wr(uintptr_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
+
+/* Table DFS du wrap 0 sur le SM7125 (gcc-atoll, ordre des niveaux à confirmer : niveau 0 lu et affiché). */
+static const uint32_t bt_rates[] = { 7372800, 14745600, 19200000, 29491200, 32000000, 48000000, 64000000,
+	                             75000000, 80000000, 96000000, 100000000, 102400000, 112000000, 117964800 };
+
+static int
+bt_send(void *ctx, const uint8_t *p, size_t n)
+{
+	return geni_uart_write(ctx, p, n);
+}
+
+/* Assemble un paquet H4 d'événement depuis le flux UART (0x04, code, longueur, données). */
+static int
+bt_recv(void *ctx, uint8_t *e, size_t cap, size_t *n, unsigned ms)
+{
+	static uint8_t buf[512];
+	static size_t have;
+	for (unsigned t = 0; t <= ms; t += 5) {
+		have += geni_uart_read(ctx, buf + have, sizeof(buf) - have);
+		while (have && buf[0] != 0x04) {          /* resynchroniser sur un début d'événement */
+			memmove(buf, buf + 1, --have);
+		}
+		if (have >= 3 && have >= 3u + buf[2]) {
+			size_t len = 3u + buf[2];
+			*n = len < cap ? len : cap;
+			memcpy(e, buf, *n);
+			memmove(buf, buf + len, have - len);
+			have -= len;
+			return 0;
+		}
+		touch_wait(5);
+	}
+	return -1;
+}
+
+static void
+bt_thread(void *arg, wait_result_t result)
+{
+	(void)arg; (void)result;
+	static struct geni_uart u;
+	static struct qca_bt bt;
+	touch_wait(20000);                                   /* après le tactile et le gros du démarrage */
+	bt_gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	bt_se = ml_io_map(BT_SE_PA, 0x4000);
+	bt_tlmm = ml_io_map(BT_SOUTH_PA, 0x30000);
+	if (!bt_gcc || !bt_se || !bt_tlmm) {
+		printf("SWEET BT: MMIO mapping failed\n");
+		goto out;
+	}
+	bt_wr(bt_gcc + BT_GCC_VOTE, bt_rd(bt_gcc + BT_GCC_VOTE) | BT_GCC_BITS);
+	printf("SWEET BT: GCC vote=%#x rcg=%#x dfs0=%#x\n", bt_rd(bt_gcc + BT_GCC_VOTE), bt_rd(bt_gcc + BT_RCG),
+	    bt_rd(bt_gcc + BT_RCG + 0x1cu));
+	/* broches UART : fonction qup05 (3 pour la 25, 2 pour 26-28), 8 mA */
+	static const unsigned pins[4] = { 25, 26, 27, 28 }, func[4] = { 3, 2, 2, 2 };
+	for (unsigned i = 0; i < 4; i++) {
+		bt_wr(bt_tlmm + pins[i] * 0x1000u, func[i] << 2 | 3u << 6);
+	}
+	int e1 = sweet_rpmh_vreg_enable("ldoc1", 1800), e2 = sweet_rpmh_vreg_enable("ldoc2", 1300),
+	    e3 = sweet_rpmh_vreg_enable("ldoc10", 3300);
+	printf("SWEET BT: rails L1C=%d L2C=%d L10C=%d\n", e1, e2, e3);
+	if (e1 || e2 || e3) {
+		goto out;
+	}
+	touch_wait(100);
+	u.m = (struct geni_mmio){ bt_se, bt_rd, bt_wr };
+	if (geni_uart_init(&u, bt_rates, sizeof(bt_rates) / sizeof(bt_rates[0]), 115200)) {
+		printf("SWEET BT: no exact clock for 115200\n");
+		goto out;
+	}
+	bt.io = (struct qca_bt_io){ &u, bt_send, bt_recv };
+	int err = qca_bt_version(&bt);
+	printf("SWEET BT: WCN3990 version err=%d product=%#x rom=%#x patch=%#x soc=%#x\n", err, bt.product_id,
+	    bt.rom_ver, bt.patch_ver, bt.soc_id);
+	if (err) {
+		goto out;
+	}
+	/* Sans firmware (pas encore dans l'image) : la ROM du contrôleur répond au reset et peut scanner. */
+	err = qca_bt_reset(&bt);
+	printf("SWEET BT: HCI reset %d; scanning BLE for 10 s\n", err);
+	if (!err && !qca_bt_scan(&bt, 10000)) {
+		printf("SWEET BT: %u device(s) around\n", bt.nseen);
+		for (unsigned i = 0; i < bt.nseen; i++) {
+			struct qca_bt_device *d = &bt.seen[i];
+			printf("SWEET BT:   %02X:%02X:%02X:%02X:%02X:%02X %d dBm %s\n", d->addr[5], d->addr[4], d->addr[3],
+			    d->addr[2], d->addr[1], d->addr[0], d->rssi, d->name);
+		}
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+tabs6lite_bt_init(void)
+{
+	int on = 0;
+	thread_t t;
+	(void)PE_parse_boot_argn("tabs6lite_bt", &on, sizeof(on));
+	if (on && kernel_thread_start(bt_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
diff --color -ruN a/bsd/dev/tabs6lite_geni_uart.c b/bsd/dev/tabs6lite_geni_uart.c
--- a/bsd/dev/tabs6lite_geni_uart.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_geni_uart.c	2026-11-13 14:17:11
@@ -0,0 +1,147 @@
+/*
+ * UART du moteur série Qualcomm GENI, pour le Bluetooth de la Tab S6 Lite 2022 :
+ * qupv3_se3_4uart à 0x88c000, horloge GCC « wrap0 S3 » (RCG 0x173c4, table DFS).
+ * Registres d'après les pilotes Linux qcom_geni_serial et qcom-geni-se (faits) ; même moteur que
+ * l'I2C du tactile (sweet_touch.c), ici en mode UART. Écrit pour ce portage.
+ *
+ * Vitesses : sur-échantillonnage 32. La table de fréquences du SM7125 contient 7,3728 MHz
+ * (115200 bauds = 7,3728 MHz / 2 / 32, la vitesse de démarrage de la WCN3990) et 96 MHz
+ * (3 Mbauds = 96 MHz / 1 / 32, après le chargement du firmware) : deux réglages exacts.
+ */
+#include "geni_uart.h"
+
+#define SE_M_CLK_CFG        0x048
+#define SE_S_CLK_CFG        0x04c
+#define SE_CLK_SEL          0x07c
+#define SE_UART_TX_TRANS_CFG 0x25c
+#define SE_TX_PACK0         0x260
+#define SE_TX_PACK1         0x264
+#define SE_UART_TX_WORD_LEN 0x268
+#define SE_UART_TX_STOP_LEN 0x26c
+#define SE_UART_TX_LEN      0x270
+#define SE_UART_RX_TRANS_CFG 0x280
+#define SE_RX_PACK0         0x284
+#define SE_RX_PACK1         0x288
+#define SE_UART_RX_WORD_LEN 0x28c
+#define SE_UART_RX_STALE    0x294
+#define SE_UART_TX_PARITY   0x2a4
+#define SE_UART_RX_PARITY   0x2a8
+#define SE_M_CMD0           0x600
+#define SE_M_IRQ_STATUS     0x610
+#define SE_M_IRQ_CLEAR      0x618
+#define SE_S_CMD0           0x630
+#define SE_S_IRQ_CLEAR      0x648
+#define SE_TX_FIFO          0x700
+#define SE_RX_FIFO          0x780
+#define SE_RX_FIFO_STATUS   0x804
+
+#define OPCODE_SHIFT        27
+#define UART_START          1u
+#define M_CMD_DONE          (1u << 0)
+#define RX_WORDS            0x01ffffffu
+#define RX_LAST             (1u << 31)
+#define RX_LAST_VALID_SHIFT 28
+#define OVERSAMPLING        32u
+#define STALE_COUNT         (16u * 10u)   /* 16 caractères de 10 bits */
+
+/* Valeurs de packing pour des mots de 4 octets, 8 bits, poids faible en premier (calculées d'après
+ * l'algorithme de geni_se_config_packing : 4 vecteurs {début, sens, longueur}, arrêt sur le dernier). */
+uint32_t
+geni_pack_word(unsigned vector0, unsigned vector1)
+{
+	return vector0 | vector1 << 10;
+}
+
+static unsigned
+pack_vector(unsigned i)
+{
+	unsigned v = (i * 8u) << 5 | 0u << 4 | 7u << 1;   /* début i*8, poids faible d'abord, 8 bits */
+	return i == 3 ? v | 1u : v;                         /* bit d'arrêt sur le 4e octet */
+}
+
+int
+geni_uart_plan(const uint32_t *rates, unsigned n, uint32_t baud, unsigned *level, unsigned *div)
+{
+	uint64_t want = (uint64_t)baud * OVERSAMPLING;
+	for (unsigned i = 0; i < n; i++) {
+		if (rates[i] % want == 0 && rates[i] / want <= 0xfff) {
+			*level = i;
+			*div = (unsigned)(rates[i] / want);
+			return 0;                               /* réglage exact */
+		}
+	}
+	return -1;
+}
+
+int
+geni_uart_init(struct geni_uart *u, const uint32_t *rates, unsigned n, uint32_t baud)
+{
+	unsigned level, div;
+	if (geni_uart_plan(rates, n, baud, &level, &div)) {
+		return -1;
+	}
+	struct geni_mmio *m = &u->m;
+	m->wr(m->base + SE_CLK_SEL, level);
+	m->wr(m->base + SE_M_CLK_CFG, div << 4 | 1u);
+	m->wr(m->base + SE_S_CLK_CFG, div << 4 | 1u);
+	uint32_t p0 = geni_pack_word(pack_vector(0), pack_vector(1));
+	uint32_t p1 = geni_pack_word(pack_vector(2), pack_vector(3));
+	m->wr(m->base + SE_TX_PACK0, p0);
+	m->wr(m->base + SE_TX_PACK1, p1);
+	m->wr(m->base + SE_RX_PACK0, p0);
+	m->wr(m->base + SE_RX_PACK1, p1);
+	m->wr(m->base + SE_UART_TX_TRANS_CFG, 0);          /* sans parité ; CTS : non (lignes à 4 fils au DT, à activer après) */
+	m->wr(m->base + SE_UART_TX_WORD_LEN, 8);
+	m->wr(m->base + SE_UART_TX_STOP_LEN, 0);           /* 1 bit d'arrêt */
+	m->wr(m->base + SE_UART_TX_PARITY, 0);
+	m->wr(m->base + SE_UART_RX_TRANS_CFG, 0);
+	m->wr(m->base + SE_UART_RX_WORD_LEN, 8);
+	m->wr(m->base + SE_UART_RX_PARITY, 0);
+	m->wr(m->base + SE_UART_RX_STALE, STALE_COUNT);
+	m->wr(m->base + SE_S_CMD0, UART_START << OPCODE_SHIFT);   /* réception permanente */
+	u->baud = baud;
+	return 0;
+}
+
+int
+geni_uart_write(struct geni_uart *u, const uint8_t *p, size_t len)
+{
+	struct geni_mmio *m = &u->m;
+	m->wr(m->base + SE_UART_TX_LEN, (uint32_t)len);
+	m->wr(m->base + SE_M_CMD0, UART_START << OPCODE_SHIFT);
+	for (size_t at = 0; at < len; at += 4) {
+		uint32_t w = 0;
+		for (unsigned b = 0; b < 4 && at + b < len; b++) {
+			w |= (uint32_t)p[at + b] << (8 * b);       /* poids faible en premier, comme le packing */
+		}
+		m->wr(m->base + SE_TX_FIFO, w);
+	}
+	for (unsigned i = 0; i < 100000; i++) {
+		if (m->rd(m->base + SE_M_IRQ_STATUS) & M_CMD_DONE) {
+			m->wr(m->base + SE_M_IRQ_CLEAR, M_CMD_DONE);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+size_t
+geni_uart_read(struct geni_uart *u, uint8_t *p, size_t cap)
+{
+	struct geni_mmio *m = &u->m;
+	uint32_t st = m->rd(m->base + SE_RX_FIFO_STATUS);
+	unsigned words = st & RX_WORDS;
+	size_t got = 0;
+	for (unsigned i = 0; i < words; i++) {
+		uint32_t w = m->rd(m->base + SE_RX_FIFO);
+		unsigned bytes = 4;
+		if (i == words - 1 && (st & RX_LAST)) {
+			unsigned valid = (st >> RX_LAST_VALID_SHIFT) & 7u;
+			bytes = valid ? valid : 4;                  /* 0 : mot complet */
+		}
+		for (unsigned b = 0; b < bytes && got < cap; b++) {
+			p[got++] = (uint8_t)(w >> (8 * b));
+		}
+	}
+	return got;
+}
diff --color -ruN a/bsd/dev/tabs6lite_qca_bt.c b/bsd/dev/tabs6lite_qca_bt.c
--- a/bsd/dev/tabs6lite_qca_bt.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_qca_bt.c	2026-11-13 14:17:11
@@ -0,0 +1,214 @@
+/* Démarrage du Bluetooth de la WCN3990 et scan LE : voir qca_bt.h. Écrit pour ce portage. */
+#include "qca_bt.h"
+#ifdef KERNEL
+#include <sys/errno.h>
+#include <libkern/libkern.h>   /* memcpy, memcmp, memset dans XNU */
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+
+#define H4_CMD          0x01
+#define H4_EVT          0x04
+#define EVT_CMD_DONE    0x0e
+#define EVT_CMD_STATUS  0x0f
+#define EVT_LE_META     0x3e
+#define LE_ADV_REPORT   0x02
+#define EVT_VENDOR      0xff
+#define OP_QCA_EDL      0xfc00u
+#define EDL_VERSION     0x19u
+#define EDL_TLV         0x1eu
+#define EDL_TLV_DONE    0x04u
+#define OP_RESET        0x0c03u
+#define OP_LE_SCAN_PRM  0x200bu
+#define OP_LE_SCAN_EN   0x200cu
+
+static int
+command(struct qca_bt *bt, uint16_t op, const uint8_t *p, uint8_t n)
+{
+	uint8_t pkt[4 + 255];
+	pkt[0] = H4_CMD;
+	pkt[1] = (uint8_t)op;
+	pkt[2] = (uint8_t)(op >> 8);
+	pkt[3] = n;
+	memcpy(pkt + 4, p, n);
+	return bt->io.send(bt->io.ctx, pkt, 4u + n);
+}
+
+/* Un événement H4 dans `e` ; renvoie son code, -1 si rien dans le délai. */
+static int
+event(struct qca_bt *bt, uint8_t *e, size_t *len, unsigned ms)
+{
+	if (bt->io.recv(bt->io.ctx, e, 260, len, ms) || *len < 3 || e[0] != H4_EVT) {
+		return -1;
+	}
+	return e[1];
+}
+
+/* Attend Command Complete de `op` ; renvoie son statut, ou -ETIMEDOUT. */
+static int
+wait_done(struct qca_bt *bt, uint16_t op)
+{
+	uint8_t e[260];
+	size_t n;
+	for (unsigned i = 0; i < 20; i++) {
+		int code = event(bt, e, &n, 100);
+		if (code == EVT_CMD_DONE && n >= 7 && (e[4] | e[5] << 8) == op) {
+			return e[6];
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+/* Attend l'événement vendeur Qualcomm {0x00, rtype, ...} ; renvoie sa longueur utile ou -ETIMEDOUT. */
+static int
+wait_vendor(struct qca_bt *bt, uint8_t rtype, uint8_t *e, size_t *n)
+{
+	for (unsigned i = 0; i < 20; i++) {
+		int code = event(bt, e, n, 100);
+		if (code == EVT_VENDOR && *n >= 5 && e[3] == 0x00 && e[4] == rtype) {
+			return (int)*n;
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+static uint32_t le32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+static uint16_t le16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
+
+int
+qca_bt_version(struct qca_bt *bt)
+{
+	const uint8_t req = EDL_VERSION;
+	uint8_t e[260];
+	size_t n;
+	int err = command(bt, OP_QCA_EDL, &req, 1);
+	if (err) {
+		return err;
+	}
+	/* événement vendeur : 0x04 0xff len | 0x00 0x19 | product_id(4) patch(2) rom(2) soc_id(4) */
+	if (wait_vendor(bt, EDL_VERSION, e, &n) < 0 || n < 5 + 12) {
+		return -ETIMEDOUT;
+	}
+	bt->product_id = le32(e + 5);
+	bt->patch_ver = le16(e + 9);
+	bt->rom_ver = le16(e + 11);
+	bt->soc_id = le32(e + 13);
+	return 0;
+}
+
+int
+qca_bt_download(struct qca_bt *bt, const uint8_t *tlv, size_t len)
+{
+	uint8_t seg[2 + QCA_SEGMENT_MAX], e[260];
+	size_t n;
+	for (size_t at = 0; at < len;) {
+		size_t k = len - at < QCA_SEGMENT_MAX ? len - at : QCA_SEGMENT_MAX;
+		seg[0] = EDL_TLV;
+		seg[1] = (uint8_t)k;
+		memcpy(seg + 2, tlv + at, k);
+		int err = command(bt, OP_QCA_EDL, seg, (uint8_t)(k + 2));
+		if (err) {
+			return err;
+		}
+		/* chaque segment est acquitté par {0x00, 0x04, statut} */
+		if (wait_vendor(bt, EDL_TLV_DONE, e, &n) < 0) {
+			return -ETIMEDOUT;
+		}
+		if (n >= 6 && e[5] != 0) {
+			return -EIO;
+		}
+		at += k;
+		bt->segments++;
+	}
+	return 0;
+}
+
+int
+qca_bt_reset(struct qca_bt *bt)
+{
+	int err = command(bt, OP_RESET, NULL, 0);
+	return err ? err : wait_done(bt, OP_RESET);
+}
+
+static struct qca_bt_device *
+device_for(struct qca_bt *bt, const uint8_t *addr)
+{
+	for (unsigned i = 0; i < bt->nseen; i++) {
+		if (!memcmp(bt->seen[i].addr, addr, 6)) {
+			return &bt->seen[i];
+		}
+	}
+	if (bt->nseen == QCA_MAX_DEVICES) {
+		return NULL;
+	}
+	struct qca_bt_device *d = &bt->seen[bt->nseen++];
+	memset(d, 0, sizeof(*d));
+	memcpy(d->addr, addr, 6);
+	return d;
+}
+
+void
+qca_bt_adv_report(struct qca_bt *bt, const uint8_t *e, size_t len)
+{
+	/* 0x04 0x3e plen | 0x02 nombre | (type, type_adr, adr[6], long, données[long], rssi) ... */
+	if (len < 5 || e[1] != EVT_LE_META || e[3] != LE_ADV_REPORT) {
+		return;
+	}
+	size_t at = 5;
+	for (unsigned r = 0; r < e[4]; r++) {
+		if (at + 9 > len) {
+			return;
+		}
+		const uint8_t *addr = e + at + 2;
+		uint8_t dl = e[at + 8];
+		const uint8_t *ad = e + at + 9;
+		if (at + 9 + dl + 1 > len) {
+			return;
+		}
+		struct qca_bt_device *d = device_for(bt, addr);
+		if (d) {
+			d->rssi = (int8_t)ad[dl];
+			for (size_t i = 0; i + 1 < dl && ad[i];) {   /* structures AD : longueur, type, données */
+				uint8_t l = ad[i], t = ad[i + 1];
+				if (i + 1 + l > dl) {
+					break;
+				}
+				if ((t == 0x09 || t == 0x08) && l > 1) {
+					size_t m = l - 1 < sizeof(d->name) - 1 ? l - 1 : sizeof(d->name) - 1;
+					memcpy(d->name, ad + i + 2, m);
+					d->name[m] = 0;
+				}
+				i += 1u + l;
+			}
+		}
+		at += 9u + dl + 1u;
+	}
+}
+
+int
+qca_bt_scan(struct qca_bt *bt, unsigned ms)
+{
+	/* passif, intervalle = fenêtre = 10 ms (0x10 x 0,625 ms), adresse publique, sans filtre */
+	const uint8_t prm[7] = { 0x00, 0x10, 0x00, 0x10, 0x00, 0x00, 0x00 };
+	const uint8_t on[2] = { 0x01, 0x00 }, off[2] = { 0x00, 0x00 };
+	uint8_t e[260];
+	size_t n;
+	int err = command(bt, OP_LE_SCAN_PRM, prm, sizeof(prm));
+	if (!err && (err = wait_done(bt, OP_LE_SCAN_PRM)) == 0) {
+		err = command(bt, OP_LE_SCAN_EN, on, sizeof(on));
+		if (!err) {
+			err = wait_done(bt, OP_LE_SCAN_EN);
+		}
+	}
+	if (err) {
+		return err;
+	}
+	for (unsigned waited = 0; waited < ms; waited += 100) {
+		if (event(bt, e, &n, 100) == EVT_LE_META) {
+			qca_bt_adv_report(bt, e, n);
+		}
+	}
+	command(bt, OP_LE_SCAN_EN, off, sizeof(off));
+	return wait_done(bt, OP_LE_SCAN_EN) == 0 ? 0 : -EIO;
+}

diff --color -ruN a/bsd/dev/geni_uart.h b/bsd/dev/geni_uart.h
--- a/bsd/dev/geni_uart.h	1970-01-01 01:00:00
+++ b/bsd/dev/geni_uart.h	2026-11-13 14:17:11
@@ -0,0 +1,27 @@
+/* UART GENI du Bluetooth (Tab S6 Lite 2022) : voir geni_uart.c. */
+#ifndef GENI_UART_H
+#define GENI_UART_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define GENI_UART_BT_PA   0x0088c000u   /* qupv3_se3_4uart */
+
+struct geni_mmio {
+	uintptr_t base;
+	uint32_t (*rd)(uintptr_t addr);
+	void (*wr)(uintptr_t addr, uint32_t value);
+};
+
+struct geni_uart {
+	struct geni_mmio m;
+	uint32_t baud;
+};
+
+/* Choisit, dans la table DFS de l'horloge, le niveau et le diviseur qui donnent `baud` exactement. */
+int geni_uart_plan(const uint32_t *rates, unsigned n, uint32_t baud, unsigned *level, unsigned *div);
+int geni_uart_init(struct geni_uart *u, const uint32_t *rates, unsigned n, uint32_t baud);
+int geni_uart_write(struct geni_uart *u, const uint8_t *p, size_t len);
+/* Ce qui est arrivé dans le FIFO de réception (non bloquant). */
+size_t geni_uart_read(struct geni_uart *u, uint8_t *p, size_t cap);
+uint32_t geni_pack_word(unsigned vector0, unsigned vector1);
+#endif
diff --color -ruN a/bsd/dev/qca_bt.h b/bsd/dev/qca_bt.h
--- a/bsd/dev/qca_bt.h	1970-01-01 01:00:00
+++ b/bsd/dev/qca_bt.h	2026-11-13 14:17:11
@@ -0,0 +1,53 @@
+/*
+ * Bluetooth de la WCN3990 (Tab S6 Lite 2022) sans pile Bluetooth d'iOS : démarrer le contrôleur et
+ * scanner en Bluetooth Low Energy depuis le noyau, pour montrer que la radio marche réellement.
+ *
+ * Sur cette puce, la partie Bluetooth ne dépend pas du modem : elle est reliée par l'UART haut débit
+ * qupv3_se3_4uart (0x88c000) et reçoit son firmware par des commandes HCI propres à Qualcomm, comme le
+ * fait le pilote Linux btqca (faits relevés : commande 0xFC00, sous-commandes 0x19 version et 0x1E
+ * segment de TLV, segments de 243 octets au plus, événements vendeur 0xFF). Le reste est du HCI
+ * standard (Core Spec) : HCI_Reset, LE Set Scan Parameters/Enable, LE Advertising Report.
+ *
+ * Le module fabrique les paquets HCI (format H4 : 0x01 commande, 0x04 événement) et lit les
+ * événements ; l'intégrateur fournit l'envoi et la réception sur l'UART. Écrit pour ce portage.
+ */
+#ifndef QCA_BT_H
+#define QCA_BT_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define QCA_SEGMENT_MAX     243u
+#define QCA_MAX_DEVICES     16u
+
+struct qca_bt_io {
+	void *ctx;
+	int (*send)(void *ctx, const uint8_t *h4, size_t len);              /* un paquet H4 complet */
+	int (*recv)(void *ctx, uint8_t *h4, size_t cap, size_t *len, unsigned timeout_ms);
+};
+
+struct qca_bt_device {
+	uint8_t addr[6];        /* adresse, octet de poids fort en dernier (ordre HCI) */
+	int8_t rssi;
+	char name[32];          /* nom annoncé (AD 0x09 ou 0x08), vide sinon */
+};
+
+struct qca_bt {
+	struct qca_bt_io io;
+	uint32_t product_id, soc_id;
+	uint16_t rom_ver, patch_ver;
+	unsigned segments;
+	struct qca_bt_device seen[QCA_MAX_DEVICES];
+	unsigned nseen;
+};
+
+/* Version du contrôleur (rom_ver sert à choisir crbtfw<rom>.tlv et crnv<rom>.bin). */
+int qca_bt_version(struct qca_bt *bt);
+/* Envoie un fichier TLV (correctif rampatch ou NVM) segment par segment. */
+int qca_bt_download(struct qca_bt *bt, const uint8_t *tlv, size_t len);
+int qca_bt_reset(struct qca_bt *bt);
+/* Scan LE passif pendant `ms` : remplit bt->seen (une entrée par adresse). */
+int qca_bt_scan(struct qca_bt *bt, unsigned ms);
+/* Décode un événement LE Advertising Report (utilisé par qca_bt_scan, exposé pour les tests). */
+void qca_bt_adv_report(struct qca_bt *bt, const uint8_t *evt, size_t len);
+#endif

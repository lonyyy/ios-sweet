+uint64_t
+sweet_surface_contiguous(IOMemoryDescriptor *memory, uint64_t size)
+{
+	IOByteCount len = 0;
+	uint64_t phys = memory->getPhysicalSegment(0, &len, kIOMemoryMapperNone);
+	for (uint64_t off = page_size; phys != 0 && off < size; off += page_size) {
+		if (memory->getPhysicalSegment(off, &len, kIOMemoryMapperNone) != phys + off) {
+			return 0;
+		}
+	}
+	return phys != 0 && phys + size <= 0x100000000ULL ? phys : 0;
+}

diff --color -ruN a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
--- a/bsd/dev/sweet_rpmh.c	2026-11-13 14:51:14
+++ b/bsd/dev/sweet_rpmh.c	2026-11-13 14:51:36
@@ -4,6 +4,7 @@
  * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <stdbool.h>
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/errno.h>
@@ -327,9 +328,24 @@
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
-	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
-	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
-		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+	/*
+	 * Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources.
+	 * Tab S6 Lite 2022 (SM-P613) : only the rails its DT gives to the touch panel, the S Pen and
+	 * the WCN3990 Bluetooth, each with the voltage window of its DT regulator node.
+	 */
+	static const struct { char name[8]; unsigned lo, hi; } allowed[] = {
+		{ "ldoc11", 2950, 3400 },   /* sweet's own rail (kept) ; WCN3990 vdd-3.3-ch1 */
+		{ "ldoc7", 2950, 3400 },    /* pm6150l L7C "wacom_avdd" : touch avdd and S Pen */
+		{ "ldoc1", 1700, 1950 },    /* pm6150l L1C : WCN3990 vdd-1.8-xo */
+		{ "ldoc2", 1200, 1400 },    /* pm6150l L2C : WCN3990 vdd-1.3-rfa / BT core */
+		{ "ldoc10", 2950, 3400 },   /* pm6150l L10C : WCN3990 vdd-3.3-ch0 / BT PA */
+	};
+	bool ok = false;
+	for (unsigned i = 0; res && i < sizeof(allowed) / sizeof(allowed[0]) && !ok; i++) {
+		ok = !strcmp(res, allowed[i].name) && mv >= allowed[i].lo && mv <= allowed[i].hi;
+	}
+	if (!ok) {
+		printf("SWEET RPMH: %s %u mV is not a Tab S6 Lite touch/S Pen/Bluetooth rail\n", res ? res : "?", mv);
 		return EINVAL;
 	}
 	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {

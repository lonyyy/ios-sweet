diff --color -ruN a/bsd/dev/himax.h b/bsd/dev/himax.h
--- a/bsd/dev/himax.h	1970-01-01 01:00:00
+++ b/bsd/dev/himax.h	2026-11-15 13:23:04
@@ -0,0 +1,35 @@
+/*
+ * Tactile de la Tab S6 Lite 2022 : la dalle Himax HX83102E (TDDI) en SPI mode 3, sur SE6
+ * (GPIO 59 MISO, 60 MOSI, 61 CLK, 62 CS ; IRQ GPIO 9 active basse ; reset GPIO 32).
+ * Protocole relevé dans le pilote Himax public (hxchipset, variante Samsung) :
+ *   lecture  : CS bas, F3 <reg> 00, puis n octets lus, CS haut
+ *   écriture : CS bas, F2 <reg> <données>, CS haut
+ *   registre 32 bits (bus AHB interne) : 13 <- 31, 0D <- 10, 00 <- adresse LE, 0C <- 00, lire 08 (4 octets)
+ *   trame tactile : 11 <- 00, lire 30 (80 octets), 11 <- 01
+ * Le firmware est dans la flash de la puce (journal Android : CRC bon, « reload OK ») : rien à envoyer.
+ */
+#ifndef HIMAX_H
+#define HIMAX_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define HIMAX_MAX_PT     10
+#define HIMAX_EVENT_LEN  80      /* (10 + 2 + 2) * 4 + 24 octets Samsung (SEC_PALM_FUNC) */
+#define HIMAX_ICID_ADDR  0x900000d0u
+
+struct himax_io {
+	void *ctx;
+	/* une sélection : envoie tx[nt], puis lit rx[nr] ; 0 ou erreur */
+	int (*xfer)(void *ctx, const uint8_t *tx, size_t nt, uint8_t *rx, size_t nr);
+};
+
+struct himax_point { int x, y; unsigned w; };
+
+int himax_read(const struct himax_io *io, uint8_t reg, uint8_t *buf, size_t n);
+int himax_write(const struct himax_io *io, uint8_t reg, const uint8_t *buf, size_t n);
+int himax_reg_read32(const struct himax_io *io, uint32_t addr, uint32_t *val);
+int himax_read_event(const struct himax_io *io, uint8_t *buf);
+/* Points posés dans une trame (x de 0 à 1199, y de 0 à 2399 au plus) ; renvoie leur nombre, -1 si trame vide/invalide. */
+int himax_parse(const uint8_t *buf, struct himax_point *pt, unsigned *mask);
+#endif

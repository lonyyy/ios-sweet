diff --color -ruN a/bsd/dev/tabs6lite_himax.c b/bsd/dev/tabs6lite_himax.c
--- a/bsd/dev/tabs6lite_himax.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_himax.c	2026-11-15 13:23:04
@@ -0,0 +1,132 @@
+/*
+ * Tactile au doigt de la Tab S6 Lite 2022 sous XNU : la dalle Himax HX83102E en SPI logiciel
+ * (SE6 est configuré « GSI seul » par le firmware, comme SE7). Inclus depuis bsd/dev/sweet_touch.c,
+ * dont il réutilise touch_gpio(), touch_gpio_level(), touch_tile(), touch_wait() et touch_report().
+ * Broches (DT qupv3_se6_spi_active_tsp + journal Android « gpio_irq=9, gpio_rst=32 ») :
+ *   59 MISO, 60 MOSI, 61 CLK, 62 CS (ordre des broches GENI : la 62 est cs-gpios au DT), mode 3.
+ * GPIO 8 n'est jamais touché : c'est le reset de l'écran.
+ */
+#include "tabs6lite_himax_proto.c"
+
+#define HX_CLK   61u
+#define HX_CS    62u
+#define HX_IRQ   9u
+#define HX_RST   32u
+
+static unsigned hx_miso = 59u, hx_mosi = 60u;
+static struct himax_point hx_pt[HIMAX_MAX_PT];
+
+static inline void
+hx_set(unsigned pin, bool high)
+{
+	touch_wr(touch_tile(pin), TOUCH_GPIO_IO(pin), high ? 2u : 0u);
+}
+
+static uint8_t
+hx_byte(uint8_t out)
+{
+	uint8_t in = 0;
+	for (int b = 7; b >= 0; b--) {          /* mode 3 : sortie sur le front descendant, lecture au montant */
+		hx_set(HX_CLK, false);
+		hx_set(hx_mosi, (out >> b) & 1u);
+		delay(1);
+		hx_set(HX_CLK, true);
+		in = (uint8_t)(in << 1 | (touch_gpio_level(hx_miso) ? 1u : 0u));
+		delay(1);
+	}
+	return in;
+}
+
+static int
+hx_xfer(void *ctx, const uint8_t *tx, size_t nt, uint8_t *rx, size_t nr)
+{
+	(void)ctx;
+	hx_set(HX_CS, false);
+	delay(1);
+	for (size_t i = 0; i < nt; i++) {
+		(void)hx_byte(tx[i]);
+	}
+	for (size_t i = 0; i < nr; i++) {
+		rx[i] = hx_byte(0);
+	}
+	hx_set(HX_CS, true);
+	delay(2);
+	return 0;
+}
+
+static const struct himax_io hx_io = { NULL, hx_xfer };
+
+static void
+hx_pins(void)
+{
+	touch_gpio(HX_CS, 0, 0, 2, true, true);
+	touch_gpio(HX_CLK, 0, 0, 2, true, true);
+	touch_gpio(hx_mosi, 0, 0, 2, true, false);
+	touch_gpio(hx_miso, 0, 1, 0, false, false);         /* entrée, rappel bas : 0 franc si personne ne répond */
+}
+
+static bool
+hx_identify(const char *when)
+{
+	for (unsigned swap = 0; swap < 2; swap++) {
+		hx_miso = swap ? 60u : 59u;
+		hx_mosi = swap ? 59u : 60u;
+		hx_pins();
+		uint32_t id = 0;
+		uint8_t r13 = 0;
+		(void)himax_read(&hx_io, 0x13, &r13, 1);
+		(void)himax_reg_read32(&hx_io, HIMAX_ICID_ADDR, &id);
+		printf("SWEET TOUCH: himax %s miso=%u id=%#x reg13=%#x irq=%u\n", when, hx_miso, id, r13,
+		    touch_gpio_level(HX_IRQ));
+		if ((id >> 8) == 0x83102eu) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Puce prête : identité lue, sans reset d'abord (l'écran tourne), puis après un reset de la partie tactile. */
+static bool
+hx_start(void)
+{
+	touch_gpio(HX_IRQ, 0, 3, 0, false, false);          /* entrée, rappel haut : l'IRQ est active basse */
+	if (hx_identify("as found")) {
+		return true;
+	}
+	/* Android : rst 0 pendant 20 ms, puis 1 ; le firmware se recharge depuis la flash. */
+	touch_gpio(HX_RST, 0, 0, 2, true, false);
+	touch_wait(20);
+	touch_gpio(HX_RST, 0, 0, 2, true, true);
+	touch_wait(150);
+	return hx_identify("after reset");
+}
+
+/* Une trame si l'IRQ est basse ; remonte les doigts 0 à 8 (le 9e emplacement est celui du S Pen). */
+static void
+hx_poll(void)
+{
+	static unsigned logged;
+	uint8_t ev[HIMAX_EVENT_LEN];
+	if (touch_gpio_level(HX_IRQ) || himax_read_event(&hx_io, ev)) {
+		return;
+	}
+	unsigned mask;
+	int n = himax_parse(ev, hx_pt, &mask);
+	if (logged < 6) {
+		logged++;
+		printf("SWEET TOUCH: himax event n=%d mask=%#x %02x%02x%02x%02x cnt=%#x x0=%d y0=%d\n", n, mask, ev[0], ev[1],
+		    ev[2], ev[3], ev[52], (mask & 1u) ? hx_pt[0].x : -1, (mask & 1u) ? hx_pt[0].y : -1);
+	}
+	if (n < 0) {
+		mask = 0;
+	}
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	mask &= (1u << SPEN_SLOT) - 1u;
+	for (unsigned i = 0; i < SPEN_SLOT; i++) {
+		x[i] = (mask >> i) & 1u ? hx_pt[i].x : 0;
+		y[i] = (mask >> i) & 1u ? hx_pt[i].y : 0;
+	}
+	x[SPEN_SLOT] = st.x[SPEN_SLOT];
+	y[SPEN_SLOT] = st.y[SPEN_SLOT];
+	touch_report(mask | (st.active & (1u << SPEN_SLOT)), x, y);
+}
diff --color -ruN a/bsd/dev/tabs6lite_himax_proto.c b/bsd/dev/tabs6lite_himax_proto.c
--- a/bsd/dev/tabs6lite_himax_proto.c	1970-01-01 01:00:00
+++ b/bsd/dev/tabs6lite_himax_proto.c	2026-11-15 13:23:04
@@ -0,0 +1,93 @@
+/* Tactile Himax HX83102E en SPI : voir himax.h. Écrit pour ce portage. */
+#include "himax.h"
+#ifdef KERNEL
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+
+#define CMD_READ   0xf3u
+#define CMD_WRITE  0xf2u
+#define COORD_SZ   (HIMAX_MAX_PT * 4)           /* x, y en gros-boutiste, 4 octets par point */
+#define AREA_SZ    12                           /* une largeur par point, arrondie à 4 */
+#define PTCNT_POS  (COORD_SZ + AREA_SZ)         /* octet du nombre de points (bits 0-3) */
+
+int
+himax_read(const struct himax_io *io, uint8_t reg, uint8_t *buf, size_t n)
+{
+	const uint8_t cmd[3] = { CMD_READ, reg, 0x00 };
+	return io->xfer(io->ctx, cmd, sizeof(cmd), buf, n);
+}
+
+int
+himax_write(const struct himax_io *io, uint8_t reg, const uint8_t *buf, size_t n)
+{
+	uint8_t f[2 + 8];
+	if (n > 8) {
+		return -EINVAL;
+	}
+	f[0] = CMD_WRITE;
+	f[1] = reg;
+	if (n) {
+		memcpy(f + 2, buf, n);
+	}
+	return io->xfer(io->ctx, f, 2 + n, NULL, 0);
+}
+
+static int
+write1(const struct himax_io *io, uint8_t reg, uint8_t v)
+{
+	return himax_write(io, reg, &v, 1);
+}
+
+int
+himax_reg_read32(const struct himax_io *io, uint32_t addr, uint32_t *val)
+{
+	const uint8_t a[4] = { (uint8_t)addr, (uint8_t)(addr >> 8), (uint8_t)(addr >> 16), (uint8_t)(addr >> 24) };
+	uint8_t d[4];
+	int e = write1(io, 0x13, 0x31);             /* accès continu */
+	if (!e) e = write1(io, 0x0d, 0x10);         /* sans auto-incrément (lecture de 4 octets) */
+	if (!e) e = himax_write(io, 0x00, a, 4);    /* adresse AHB */
+	if (!e) e = write1(io, 0x0c, 0x00);         /* sens : lecture */
+	if (!e) e = himax_read(io, 0x08, d, 4);
+	if (!e) {
+		*val = d[0] | d[1] << 8 | d[2] << 16 | (uint32_t)d[3] << 24;
+	}
+	return e;
+}
+
+int
+himax_read_event(const struct himax_io *io, uint8_t *buf)
+{
+	int e = write1(io, 0x11, 0x00);             /* lecture en rafale AHB coupée */
+	if (!e) e = himax_read(io, 0x30, buf, HIMAX_EVENT_LEN);
+	int e2 = write1(io, 0x11, 0x01);
+	return e ? e : e2;
+}
+
+int
+himax_parse(const uint8_t *buf, struct himax_point *pt, unsigned *mask)
+{
+	*mask = 0;
+	if (buf[PTCNT_POS] == 0xff) {
+		return -1;                              /* pile vide */
+	}
+	int n = 0;
+	for (unsigned i = 0; i < HIMAX_MAX_PT; i++) {
+		int x = buf[4 * i] << 8 | buf[4 * i + 1], y = buf[4 * i + 2] << 8 | buf[4 * i + 3];
+		if (x > 0x7fff || y > 0x7fff || x == 0xffff) {
+			continue;
+		}
+		if (x >= 1200 || y >= 2400) {
+			continue;                           /* hors dalle : emplacement libre (0xFFFF) */
+		}
+		pt[i].x = x;
+		pt[i].y = y;
+		pt[i].w = buf[COORD_SZ + i];
+		*mask |= 1u << i;
+		n++;
+	}
+	return n;
+}

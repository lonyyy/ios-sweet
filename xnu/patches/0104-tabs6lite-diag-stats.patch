+/*
+ * Tab S6 Lite : diagnostics (boot-arg sweetstat=N, secondes ; 0 = coupé, 10 par défaut).
+ * Au démarrage, la vitesse de chaque cœur (boucle de 2 instructions, ~1 tour par cycle :
+ * une estimation de la fréquence, pas une mesure exacte), puis toutes les N s une ligne
+ * « SWEET STAT » : images reçues/montrées, copies, temps passé à copier, lectures tactiles.
+ */
+extern uint64_t sweet_fb_stat[6];                      /* iokit/Kernel/arm/SweetFramebuffer.cpp */
+extern unsigned int real_ncpus;
+extern processor_t cpu_to_processor(int cpu);           /* osfmk : signatures de xnu-8796 */
+extern processor_t thread_bind(processor_t processor);
+
+static uint64_t
+stat_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000u;
+}
+
+static void
+stat_cpus(void)
+{
+	for (unsigned c = 0; c < real_ncpus && c < 8; c++) {
+		(void)thread_bind(cpu_to_processor((int)c));
+		thread_block(THREAD_CONTINUE_NULL);             /* migre sur le cœur c */
+		uint64_t n = 50000000u, t0 = mach_absolute_time();
+		__asm__ volatile("1: subs %0, %0, #1\n b.ne 1b" : "+r"(n) :: "cc");
+		uint64_t us = stat_us(mach_absolute_time() - t0);
+		printf("SWEET CPU: core %u ~%llu MHz (50M tours en %llu us)\n", c, us ? 50000000ull / us : 0, us);
+	}
+	(void)thread_bind((processor_t)0);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+stat_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	unsigned period = (unsigned)(uintptr_t)arg;
+	touch_wait(30000);
+	stat_cpus();
+	uint64_t fb[6] = { 0 }, hx[4] = { 0 };
+	for (;;) {
+		touch_wait(period * 1000u);
+		uint64_t f[6], h[4];
+		for (unsigned i = 0; i < 6; i++) f[i] = sweet_fb_stat[i] - fb[i], fb[i] = sweet_fb_stat[i];
+		for (unsigned i = 0; i < 4; i++) h[i] = hx_stat[i] - hx[i], hx[i] = hx_stat[i];
+		printf("SWEET STAT: %us swaps=%llu shown=%llu flip=%llu copy=%llu multi=%llu present_ms=%llu"
+		    " | hx edges=%llu reads=%llu fingers=%llu read_ms=%llu\n", period, f[0], f[1], f[2], f[3], f[5],
+		    stat_us(f[4]) / 1000u, h[0], h[1], h[2], stat_us(h[3]) / 1000u);
+	}
+}
+
+static void
+stat_init(void)
+{
+	unsigned period = 10;
+	thread_t t;
+	(void)PE_parse_boot_argn("sweetstat", &period, sizeof(period));
+	if (period && kernel_thread_start(stat_thread, (void *)(uintptr_t)period, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}

+/*
+ * ---- Synaptics TCM: Galaxy Tab S6 Lite 2022 (SM-P613), synaptics,tcm-i2c at 0x20 on SE7 ----
+ * Written for this port from the protocol as the tablet's own Linux driver uses it:
+ *   read     {0xa5, code, length LE16}, then `length` payload bytes and one 0x5a padding byte
+ *            in "continued reads", each of which starts again with {0xa5, 0x03};
+ *   command  {opcode, length LE16, payload}: the ones used here carry no payload (3 bytes,
+ *            the most touch_msg writes);
+ *   codes    0x01 OK, 0x02 busy, 0x10 identify report, 0x11 touch report.
+ * A touch report has no fixed layout: the firmware describes it (command 0x25) as a small
+ * program of field codes and bit widths, run here by syna_parse() over the report's bits.
+ */
+#define SYNA_ADDR          0x20u
+#define SYNA_MARKER        0xa5u
+#define SYNA_CONTINUED     0x03u
+#define SYNA_OK            0x01u
+#define SYNA_BUSY          0x02u
+#define SYNA_REPORT_ID     0x10u
+#define SYNA_REPORT_TOUCH  0x11u
+#define SYNA_CMD_APP_INFO  0x20u
+#define SYNA_CMD_TOUCH_CFG 0x25u
+#define SYNA_CHUNK         88u     /* touch_msg reads at most 90 bytes: 2 for the prefix */
+#define SYNA_MAX           256u
+/* report program: codes without a width byte */
+#define SYNA_F_END         0u
+#define SYNA_F_EACH_ACTIVE 1u
+#define SYNA_F_EACH        2u
+#define SYNA_F_EACH_END    3u
+#define SYNA_F_PAD         4u
+/* codes with a width byte that this driver uses */
+#define SYNA_F_INDEX       6u
+#define SYNA_F_CLASS       7u
+#define SYNA_F_X           8u
+#define SYNA_F_Y           9u
+#define SYNA_F_ACTIVE      24u
+
+static struct {
+	uint8_t cfg[SYNA_MAX], buf[SYNA_MAX];
+	unsigned cfg_len, max_x, max_y, max_objects;
+} syna;
+
+static unsigned
+syna_le16(const uint8_t *p)
+{
+	return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+/* One message into syna.buf. EAGAIN: nothing pending (no marker). */
+static int
+syna_read(uint8_t *code, unsigned *len)
+{
+	uint8_t hdr[4], part[SYNA_CHUNK + 2];
+	int err = touch_msg(SYNA_ADDR, NULL, 0, hdr, sizeof(hdr), false);
+	*len = 0;
+	if (err) {
+		return err;
+	}
+	if (hdr[0] != SYNA_MARKER) {
+		return EAGAIN;
+	}
+	*code = hdr[1];
+	unsigned total = syna_le16(hdr + 2), left = total + 1u, got = 0;
+	while (left > 1u) {             /* a last lone byte is the padding: nothing to read */
+		unsigned n = left > SYNA_CHUNK ? SYNA_CHUNK : left;
+		err = touch_msg(SYNA_ADDR, NULL, 0, part, n + 2u, false);
+		if (err) {
+			return err;
+		}
+		if (part[0] != SYNA_MARKER || part[1] != SYNA_CONTINUED) {
+			return EIO;
+		}
+		for (unsigned i = 0; i < n; ++i, ++got) {
+			if (got < total && got < SYNA_MAX) {
+				syna.buf[got] = part[2u + i];
+			}
+		}
+		left -= n;
+	}
+	*len = total < SYNA_MAX ? total : SYNA_MAX;
+	return 0;
+}
+
+/* A command without payload; skips reports until its status arrives. */
+static int
+syna_command(uint8_t op, unsigned *len)
+{
+	const uint8_t tx[3] = {op, 0, 0};
+	int err = touch_msg(SYNA_ADDR, tx, sizeof(tx), NULL, 0, false);
+	if (err) {
+		return err;
+	}
+	for (unsigned tries = 0; tries < 200; ++tries) {
+		uint8_t code = 0;
+		touch_wait(5);
+		err = syna_read(&code, len);
+		if (err == EAGAIN || (!err && (code == 0 || code == SYNA_BUSY || code >= SYNA_REPORT_ID))) {
+			continue;               /* idle, busy, or a report that is not our answer */
+		}
+		if (err) {
+			return err;
+		}
+		return code == SYNA_OK ? 0 : EIO;
+	}
+	return ETIMEDOUT;
 }
 
+/* `bits` bits (at most 32) from bit `off`, least significant bit first, as the firmware packs them. */
+static unsigned
+syna_bits(unsigned len, unsigned off, unsigned bits)
+{
+	unsigned v = 0;
+	for (unsigned i = 0; i < bits && i < 32u; ++i) {
+		unsigned b = off + i;
+		if (b / 8u >= len) {
+			break;
+		}
+		v |= (unsigned)((syna.buf[b / 8u] >> (b % 8u)) & 1u) << i;
+	}
+	return v;
+}
+
+/* Index just past the EACH_END that closes the loop starting at `idx`. */
+static unsigned
+syna_skip_loop(unsigned idx)
+{
+	while (idx < syna.cfg_len) {
+		unsigned c = syna.cfg[idx++];
+		if (c == SYNA_F_EACH_END) {
+			break;
+		}
+		if (c > SYNA_F_PAD) {
+			idx++;                  /* its width byte */
+		}
+	}
+	return idx;
+}
+
+/* Run the report program over a touch report of `len` bytes into per-object fields. */
+static void
+syna_parse(unsigned len, unsigned *status, unsigned *ox, unsigned *oy)
+{
+	unsigned idx = 0, off = 0, obj = 0, next = 0, objects = 0, active = 0, steps = 0;
+	bool active_only = false, have_active = false;
+	const unsigned report_bits = len * 8u;
+	while (idx < syna.cfg_len && ++steps < 4096u && off <= report_bits) {
+		unsigned c = syna.cfg[idx++];
+		switch (c) {
+		case SYNA_F_END:
+			return;
+		case SYNA_F_EACH_ACTIVE:
+		case SYNA_F_EACH:
+			obj = objects = 0;
+			next = idx;
+			active_only = c == SYNA_F_EACH_ACTIVE;
+			if (active_only && have_active && active == 0) {
+				idx = syna_skip_loop(idx);  /* no contact: the loop has no data */
+			}
+			break;
+		case SYNA_F_EACH_END:
+			if (active_only) {
+				if (have_active ? ++objects < active : off < report_bits) {
+					idx = next;
+				}
+			} else if (++obj < syna.max_objects && obj < TOUCH_MAX) {
+				idx = next;
+			}
+			break;
+		case SYNA_F_PAD:
+			off = (off + 7u) & ~7u;
+			break;
+		default: {
+			if (idx >= syna.cfg_len) {
+				return;
+			}
+			unsigned bits = syna.cfg[idx++];
+			unsigned v = syna_bits(len, off, bits);
+			off += bits;
+			if (c == SYNA_F_INDEX) {
+				obj = v;
+			} else if (c == SYNA_F_ACTIVE) {
+				active = v;
+				have_active = true;
+			} else if (obj < TOUCH_MAX) {
+				if (c == SYNA_F_CLASS) {
+					status[obj] = v;
+				} else if (c == SYNA_F_X) {
+					ox[obj] = v;
+				} else if (c == SYNA_F_Y) {
+					oy[obj] = v;
+				}
+			}
+			break;
+		}
+		}
+	}
+}
+
+static int
+touch_synaptics(void)
+{
+	uint8_t code = 0;
+	unsigned len = 0;
+	int err = syna_read(&code, &len);
+	if (err == EAGAIN) {
+		return 0;                       /* nothing pending: keep the contacts */
+	}
+	if (err || code != SYNA_REPORT_TOUCH) {
+		return err;
+	}
+	unsigned status[TOUCH_MAX] = {0}, ox[TOUCH_MAX] = {0}, oy[TOUCH_MAX] = {0};
+	syna_parse(len, status, ox, oy);
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < SPEN_SLOT; ++i) {      /* the last slot is the S Pen's */
+		if (!status[i]) {
+			continue;               /* 0: no object (lifted) */
+		}
+		mask |= 1u << i;
+		/* sensor coordinates -> the 1200x2000 panel */
+		x[i] = (int)(syna.max_x ? ox[i] * 1199u / syna.max_x : ox[i]);
+		y[i] = (int)(syna.max_y ? oy[i] * 1999u / syna.max_y : oy[i]);
+		x[i] = x[i] > 1199 ? 1199 : x[i];
+		y[i] = y[i] > 1999 ? 1999 : y[i];
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+/* After reset: the identify report, then the sensor size and the report program. */
 static bool
+syna_start(void)
+{
+	uint8_t code = 0;
+	unsigned len = 0;
+	int err = EAGAIN;
+	for (unsigned i = 0; i < 100 && (err == EAGAIN || code != SYNA_REPORT_ID); ++i) {
+		err = syna_read(&code, &len);
+		if (err && err != EAGAIN) {
+			break;
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: synaptics 0x20 identify err=%d code=%#x len=%u mode=%#x\n",
+	    err, code, len, len ? syna.buf[1] : 0);
+	if (err && err != EAGAIN) {
+		return false;
+	}
+	if (syna_command(SYNA_CMD_APP_INFO, &len) || len < 38u) {
+		printf("SWEET TOUCH: synaptics app info failed (len=%u)\n", len);
+		return false;
+	}
+	syna.max_x = syna_le16(syna.buf + 32);
+	syna.max_y = syna_le16(syna.buf + 34);
+	syna.max_objects = syna_le16(syna.buf + 36);
+	if (syna_command(SYNA_CMD_TOUCH_CFG, &len) || !len) {
+		printf("SWEET TOUCH: synaptics report config failed (len=%u)\n", len);
+		return false;
+	}
+	for (unsigned i = 0; i < len; ++i) {
+		syna.cfg[i] = syna.buf[i];
+	}
+	syna.cfg_len = len;
+	printf("SWEET TOUCH: synaptics max=%ux%u objects=%u report-config=%u bytes\n",
+	    syna.max_x, syna.max_y, syna.max_objects, syna.cfg_len);
+	return syna.max_objects != 0;
+}
+
+/*
+ * ---- S Pen: Wacom W90xx (wacom,w90xx at 0x56, same SE7 bus, same L7C rail) ----
+ * From the tablet's Linux driver (facts only): a coordinate packet is 17 bytes read as-is;
+ * byte 0 = type (low nibble, 1 = coordinates) | 0x80 in range | 0x10 tip down | 0x20 side
+ * button | 0x40 eraser; x and y big-endian at 1 and 3; pressure 12 bits at 5-6; tilt x/y
+ * signed at 8 and 9. Command 0x2a answers 32 bytes whose second half holds the maxima
+ * (x 1-2, y 3-4, pressure 5-6, big-endian). The DT orients it: wacom,invert = <0 1 1>
+ * (y inverted, then x and y swapped). Until the iPad identity takes it as an Apple Pencil,
+ * the pen is presented to iOS as one more finger, the last contact slot.
+ */
+#define SPEN_ADDR       0x56u
+#define SPEN_IRQ_GPIO   66u        /* wacom,irq-gpio = <tlmm 0x42> */
+#define SPEN_PACKET     17u
+#define SPEN_QUERY      0x2au
+
+struct spen_info {
+	unsigned max_x, max_y, max_pressure;
+	bool x_invert, y_invert, xy_switch;
+};
+static struct spen_info spen = {0, 0, 0, false, true, true};
+static bool spen_down;
+
+/* One packet -> panel position and pressure. Returns 1 tip down, 0 up, -1 not a coordinate. */
+static int
+spen_decode(const uint8_t *d, const struct spen_info *in, int *x, int *y, unsigned *pressure)
+{
+	if ((d[0] & 0x0fu) != 1u || !in->max_x || !in->max_y) {
+		return -1;
+	}
+	unsigned px = ((unsigned)d[1] << 8) | d[2], py = ((unsigned)d[3] << 8) | d[4];
+	unsigned mx = in->max_x, my = in->max_y;
+	px = px > mx ? mx : px;
+	py = py > my ? my : py;
+	if (in->x_invert) {
+		px = mx - px;
+	}
+	if (in->y_invert) {
+		py = my - py;
+	}
+	if (in->xy_switch) {
+		unsigned t = px; px = py; py = t;
+		t = mx; mx = my; my = t;
+	}
+	*x = (int)(px * 1199u / mx);
+	*y = (int)(py * 1999u / my);
+	*pressure = (((unsigned)d[5] & 0x0fu) << 8) | d[6];
+	return (d[0] & 0x80u) && (d[0] & 0x10u) ? 1 : 0;
+}
+
+static bool
+spen_start(void)
+{
+	const uint8_t q = SPEN_QUERY;
+	uint8_t a[32];
+	int err = touch_msg(SPEN_ADDR, &q, 1, NULL, 0, false);
+	touch_wait(10);
+	if (!err) {
+		err = touch_msg(SPEN_ADDR, NULL, 0, a, sizeof(a), false);
+	}
+	if (!err) {
+		spen.max_x = ((unsigned)a[17] << 8) | a[18];
+		spen.max_y = ((unsigned)a[19] << 8) | a[20];
+		spen.max_pressure = ((unsigned)a[21] << 8) | a[22];
+	}
+	printf("SWEET SPEN: query err=%d max=%ux%u pressure=%u fw=%02x%02x\n",
+	    err, spen.max_x, spen.max_y, spen.max_pressure, err ? 0 : a[23], err ? 0 : a[24]);
+	return !err && spen.max_x && spen.max_y;
+}
+
+static void
+spen_poll(void)
+{
+	if (touch_rd(st.gpio, TOUCH_GPIO_IO(SPEN_IRQ_GPIO)) & 1u) {
+		return;                 /* interrupt line high: nothing new (active low) */
+	}
+	uint8_t d[SPEN_PACKET];
+	int x, y;
+	unsigned pressure;
+	if (touch_msg(SPEN_ADDR, NULL, 0, d, sizeof(d), false)) {
+		return;
+	}
+	int down = spen_decode(d, &spen, &x, &y, &pressure);
+	if (down < 0) {
+		return;
+	}
+	if (down || spen_down) {
+		sweet_hid_touch((int)SPEN_SLOT, down, x, y);
+	}
+	spen_down = down == 1;
+}
